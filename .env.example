# Copy to .env (root, read by apps/api) and fill in. Never commit .env.

# Database (PostgreSQL 18 + PostGIS 3) — matches infra/docker-compose.yml (`pnpm infra:up`)
DATABASE_URL=postgresql://mpm:mpm@localhost:5434/mpm
# Tests use their own database and never DATABASE_URL (apps/api/vitest.config.ts refuses to run without it).
# The compose file creates it on first start; see CLAUDE.md "Local database".
TEST_DATABASE_URL=postgresql://mpm:mpm@localhost:5434/mpm_test

# Redis 7 (rate limits, OTP codes). DB 0 dev, DB 1 tests.
REDIS_URL=redis://localhost:6381
TEST_REDIS_URL=redis://localhost:6381/1

# Global API rate limit, requests per minute per client (default 120). Tests raise it themselves.
# RATE_LIMIT_MAX=120

# How many reverse proxies sit in front of the API, so request.ip and the per-IP rate limits see the real client.
# Unset or 0 means none (dev). infra/deploy's compose sets it to 1 for Caddy; a wrong count lets a client forge its IP
# (too many) or merges every client into one (too few). See infra/deploy/README.md "Client IPs behind Caddy".
# TRUST_PROXY_HOPS=1

# Background jobs start with the API unless this is exactly `false` (e.g. a second dev server on the same database).
# JOBS_ENABLED=true

# Auth — long random strings in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production
ADMIN_JWT_SECRET=change-me-in-production

# Discovery (F4 + F5): seals the search / saved-listings page cursors (AES-256-GCM). Required, at least 32 characters;
# the API refuses to start without it. Generate one per environment with the node command above.
DISCOVERY_CURSOR_SECRET=
# Prefix for discovery's Redis keys (reader version key, rate-limit buckets). Leave empty in dev and production; the
# test runner sets its own per worker.
# DISCOVERY_REDIS_PREFIX=

# Fraud signals (admin close-out §8, §16): the HMAC-SHA-256 key that turns phone numbers seen in chat into hashes for
# the "repeated phone" rule. Optional, at least 32 characters; without it that rule is off (the other rules still run).
# Keep it outside the database; rotating it breaks matching across the rotation.
SIGNAL_HASH_KEY=

# Seed admin (pnpm --filter @mpm/api db:seed)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me

# OTP / SMS — MSG91 (scope F1). Outside production the OTP is a fixed dev code (see services/otp.service.ts).
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# GST verification (scope F1, A2) — provider not chosen yet
# GST_PROVIDER: `stub` is the default outside production (unset = stub: built-in sample data, code 123456);
# `off` forces admin review, e.g. to try the review flow locally. Production never runs the stub.
GST_PROVIDER=
# GST lookups and code sends per IP per 10 minutes, each route counted on its own (default 60). Tests raise it.
# GST_IP_RATE_MAX=60
GST_API_BASE_URL=
GST_API_KEY=

# Private file storage — Cloudflare R2 only (GST review documents, F1 + A2 spec §6); no local fallback.
# The owner fills these in after the build; until then document uploads answer 503 STORAGE_UNAVAILABLE.
# AWS_S3_ENDPOINT: https://<account-id>.r2.cloudflarestorage.com
AWS_S3_ENDPOINT=
AWS_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_PRIVATE_BUCKET=

# Public listing media (F2 spec §6.1, §6.6) — for the owner. Uploads land in the private bucket under incoming-listing/
# and only checked files are copied to the public bucket. Until all of these are set, listing media endpoints answer
# 503 STORAGE_UNAVAILABLE ("Photo upload isn't available yet"); everything else works.
# R2 settings: (1) create the public bucket; (2) on the PRIVATE bucket add a lifecycle rule "delete objects with prefix
# incoming-listing/ after 1 day" (next to incoming-verification/); (3) the R2 API token above needs Object Read & Write
# on BOTH buckets (a cross-bucket copy reads one and writes the other); (4) no CORS.
# AWS_S3_PUBLIC_BUCKET: the public media bucket's name, e.g. mpm-media
AWS_S3_PUBLIC_BUCKET=
# MEDIA_PUBLIC_BASE_URL: production https://media.<domain> — a custom domain on Cloudflare connected to the public
# bucket (waits for the brand name, D1). Dev only: the bucket's https://pub-<id>.r2.dev URL (rate-limited by R2, never
# in production).
MEDIA_PUBLIC_BASE_URL=
# Cloudflare cache purge (R45): every media deletion purges its URLs. REQUIRED in production (media endpoints answer 503
# without them there); leave blank in dev on r2.dev (purging is skipped).
# CLOUDFLARE_ZONE_ID: the zone of the media custom domain.
CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_API_TOKEN: a token with Zone · Cache Purge on that zone only.
CLOUDFLARE_API_TOKEN=
# LISTING_MEDIA_OPTIONAL: dev only. true lets a listing publish without photos while R2 isn't set up (R31); ignored when
# NODE_ENV=production.
LISTING_MEDIA_OPTIONAL=
# R2_TESTS: tests only. Set R2_TESTS=1 in the shell (with the R2 keys and the public media variables above filled in
# here) to run the R2 round-trip and spike suites; they are skipped otherwise.

# Push — Firebase Cloud Messaging (scope F9, F6 + F7 spec §11.5). Opt-in, like Sentry: the base64 of the Firebase
# service-account JSON (`base64 -w0 service-account.json`). Empty: outside production pushes are logged as `sent_dev`;
# in production the API starts, warns once and records them `skipped`. In-app notifications work either way.
FIREBASE_SERVICE_ACCOUNT_B64=

# Payments — Razorpay (only if featured / promotional listings are monetised later, scope A6)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Figma MCP (used by .mcp.json — set in your shell, not here, if you prefer)
FIGMA_ACCESS_TOKEN=

# Crash reporting (Sentry) — leave blank to disable
SENTRY_DSN=

# App
API_PORT=3000
API_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3001
NODE_ENV=development
