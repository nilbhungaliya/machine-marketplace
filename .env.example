# Copy to .env (root, read by apps/api) and fill in. Never commit .env.

# Database (PostgreSQL 18 + PostGIS 3) — matches infra/docker-compose.yml (`pnpm infra:up`)
DATABASE_URL=postgresql://mpm:mpm@localhost:5434/mpm
# Tests use their own database and never DATABASE_URL (apps/api/vitest.config.ts refuses to run without it).
# The compose file creates it on first start; see CLAUDE.md "Local database".
TEST_DATABASE_URL=postgresql://mpm:mpm@localhost:5434/mpm_test

# Redis 7 (rate limits, OTP codes). DB 0 dev, DB 1 tests.
REDIS_URL=redis://localhost:6381
TEST_REDIS_URL=redis://localhost:6381/1

# Global API rate limit, requests per minute per client (default 120). Tests raise it themselves.
# RATE_LIMIT_MAX=120

# How many reverse proxies sit in front of the API, so request.ip and the per-IP rate limits see the real client.
# Unset or 0 means none (dev). infra/deploy's compose sets it to 1 for Caddy; a wrong count lets a client forge its IP
# (too many) or merges every client into one (too few). See infra/deploy/README.md "Client IPs behind Caddy".
# TRUST_PROXY_HOPS=1

# Background jobs start with the API unless this is exactly `false` (e.g. a second dev server on the same database).
# JOBS_ENABLED=true

# Auth — long random strings in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production
ADMIN_JWT_SECRET=change-me-in-production

# Seed admin (pnpm --filter @mpm/api db:seed)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me

# OTP / SMS — MSG91 (scope F1). Outside production the OTP is a fixed dev code (see services/otp.service.ts).
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# GST verification (scope F1, A2) — provider not chosen yet
# GST_PROVIDER: `stub` is the default outside production (unset = stub: built-in sample data, code 123456);
# `off` forces admin review, e.g. to try the review flow locally. Production never runs the stub.
GST_PROVIDER=
# GST lookups and code sends per IP per 10 minutes, each route counted on its own (default 60). Tests raise it.
# GST_IP_RATE_MAX=60
GST_API_BASE_URL=
GST_API_KEY=

# Private file storage — Cloudflare R2 only (GST review documents, F1 + A2 spec §6); no local fallback.
# The owner fills these in after the build; until then document uploads answer 503 STORAGE_UNAVAILABLE.
# AWS_S3_ENDPOINT: https://<account-id>.r2.cloudflarestorage.com
AWS_S3_ENDPOINT=
AWS_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_PRIVATE_BUCKET=

# Push — Firebase Cloud Messaging (scope F9)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Payments — Razorpay (only if featured / promotional listings are monetised later, scope A6)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Figma MCP (used by .mcp.json — set in your shell, not here, if you prefer)
FIGMA_ACCESS_TOKEN=

# Crash reporting (Sentry) — leave blank to disable
SENTRY_DSN=

# App
API_PORT=3000
API_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3001
NODE_ENV=development
