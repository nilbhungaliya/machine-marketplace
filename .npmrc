# pnpm dedupes peer-dependent packages by hoisting one version into
# node_modules/.pnpm/node_modules/, which breaks the admin (Next.js + React 18)
# TypeScript build: @types/react@19 from user-app gets promoted into the shared
# store and tsc mixes v19's ReactNode with v18's. Keep each workspace's own copy.
dedupe-peer-dependents=false
