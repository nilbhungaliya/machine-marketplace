{
  // Typecheck-only config. tsconfig.json is the BUILD config: rootDir "./src"
  // keeps dist mirroring src, so __tests__ can't be in its `include`. Without
  // this, tests are never typechecked and a stale field in a test only fails at
  // runtime.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src", "__tests__", "*.config.ts"],
  "exclude": ["node_modules", "dist"]
}
