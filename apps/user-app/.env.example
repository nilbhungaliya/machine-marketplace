# User app — copy to .env. EXPO_PUBLIC_* values are baked into the bundle: never put secrets here.
# On a physical phone use your machine's LAN IP, not localhost.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Crash reporting (Sentry). Leave blank to disable — the app runs normally without it.
EXPO_PUBLIC_SENTRY_DSN=

# Product analytics (PostHog). Leave blank to disable — every track() call becomes a no-op.
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google Maps on Android (Where are you? map pin). Optional: without it the screen works with the pincode and
# "Use my current location". Restrict the key to this app's package and SHA-1 in Google Cloud.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
